# brb.happyhacks.io settings. The installer copies this to .env (next to wsgi.py) and fills in SECRET_KEY.
# Edit .env on the server, then restart:   sudo supervisorctl restart doppleganger
# Keep .env private. It is never served by the website and is not overwritten by updates.

# Port gunicorn listens on (127.0.0.1 only). Must match the App Port of the site in CloudPanel.
APP_PORT=9020

# Flask secret key (signs the session cookie). The installer generates it.
SECRET_KEY=

# The address people use to reach the site (used for the Happy Hacks sign-in callback).
PUBLIC_URL=https://brb.happyhacks.io

# ---- Sign in with Happy Hacks ------------------------------------------------------------------------
# On the Happy Hacks server, from the happyhacks folder:
#   .venv/bin/python -m happyhacks.sso add doppleganger "BRB" https://brb.happyhacks.io/auth/happyhacks/callback
#   sudo supervisorctl restart happyhacks
# and paste the three lines it prints here:
HAPPYHACKS_URL=https://happyhacks.io
HAPPYHACKS_CLIENT_ID=
HAPPYHACKS_CLIENT_SECRET=

# 1 = people sign in with Happy Hacks before downloading; 0 (default) = anyone can download.
DOWNLOADS_REQUIRE_SIGNIN=0

# ---- /admin --------------------------------------------------------------------------------------------
# Emails or mobiles that are BRB admins (comma-separated); they become admins when they next sign in.
# Or: .venv/bin/python -m dopplesite.users admin you@example.com
ADMIN_CONTACTS=
# /admin is hidden (404) until an admin unlocks it on /account with an authenticator code. Set one up with:
#   .venv/bin/python -m dopplesite.users totp you@example.com
# The word that shows the unlock box when typed within 10 s of loading /account (or tap the heading 5 times).
ADMIN_UNLOCK_KEYS=unlock
# Recovery only: ADMIN_PASSWORD works on /admin/login only while ADMIN_RECOVERY=1. Leave it 0; switch it on
# just long enough to get back in (e.g. Happy Hacks sign-in is down), then off again. Every use is emailed.
ADMIN_RECOVERY=0
ADMIN_PASSWORD=

# ---- Licenses ------------------------------------------------------------------------------------------
# Free LOOP time per computer, in seconds, in total (3600 = 1 hour). Unlimited needs a license key.
FREE_SECONDS=1800
# On air when the free time runs out, the app keeps the LOOP on air this much longer (seconds) before cutting to LIVE
GRACE_SECONDS=1200
# Licensed computers keep working this many days when this site can't be reached (0 = never offline)
OFFLINE_DAYS=14
# Load: apps re-check their license this often when idle (seconds), and lease free LOOP time in chunks this long.
# Licensed computers with an offline pass don't lease at all.
STATUS_SECONDS=300
# A renewal that fails: the key keeps working this many days (emails at once and 2 days before), then pauses until
# paid; still unpaid after CANCEL_UNPAID_DAYS, the subscription is cancelled.
PAYMENT_GRACE_DAYS=7
CANCEL_UNPAID_DAYS=30
LEASE_SECONDS=30

# Square: BRB Unlimited is a monthly subscription (same Square account settings as zipzip).
# Webhook: Square Developer Dashboard > Webhooks > Add subscription, URL https://brb.happyhacks.io/api/square/webhook,
# events subscription.created, subscription.updated, invoice.payment_made; paste its signature key below.
SQUARE_ENV=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_PRODUCTION_LOCATION_ID=
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://brb.happyhacks.io/api/square/webhook
# Webhook events: subscription.created, subscription.updated, invoice.payment_made, invoice.scheduled_charge_failed
# Prices in cents. Annual is billed once a year ($83.88 = $6.99/month). The promo is a first-year price on the annual
# plan for orders up to the end of PROMO_ENDS (Eastern); after the first year it renews at ANNUAL_PRICE_CENTS.
# PROMO_ENDS=off: no promo. Square's catalog follows these by itself (Admin > Overview > Square subscriptions).
MONTHLY_PRICE_CENTS=999
ANNUAL_PRICE_CENTS=8388
PROMO_ANNUAL_PRICE_CENTS=5988
PROMO_ENDS=2026-12-31
PROMO_NAME=Holiday special
# Optional: the words in the app's Get License Key window (no app update needed to change them). Placeholders:
# {free} {monthly} {annual_month} {annual_total} {promo_month} {promo_total} {promo_name} {promo_ends}.
# Leave empty for the built-in wording. The offer line shows only while the promo runs.
PITCH_TEXT=
OFFER_TEXT=

# ---- Releases ------------------------------------------------------------------------------------------
# The public GitHub repository BRB's releases are published to.
RELEASES_REPO=busybeavernc/brb-public
# Optional: a GitHub token (no scopes needed) if the site hits GitHub's API rate limit.
GITHUB_TOKEN=

# Where the small SQLite database lives (users, download counts). The installer sets this.
DATA_DIR=

# --- Support email (support requests) ---------------------------------------------------------------------------
# Sending: the support mailbox's own outgoing server (your email host's "connect a mail app" settings).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=support@happyhacks.io
SMTP_PASSWORD=
MAIL_FROM=BRB Support <support@happyhacks.io>
# Staff told about new requests and customer replies (comma-separated), e.g. your personal address.
SUPPORT_NOTIFY=
# Receiving: read the same mailbox (read-only) so emails to support@ and replies become requests in Admin.
IMAP_HOST=
IMAP_PORT=993
# IMAP_USER / IMAP_PASSWORD default to SMTP_USER / SMTP_PASSWORD
