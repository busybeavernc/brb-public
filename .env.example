# brb.happyhacks.io settings. The installer copies this to .env (next to wsgi.py) and fills in SECRET_KEY.
# Edit .env on the server, then restart:   sudo supervisorctl restart doppleganger
# Keep .env private. It is never served by the website and is not overwritten by updates.

# Port gunicorn listens on (127.0.0.1 only). Must match the App Port of the site in CloudPanel.
APP_PORT=9020

# Flask secret key (signs the session cookie). The installer generates it.
SECRET_KEY=

# The address people use to reach the site (used for the Happy Hacks sign-in callback).
PUBLIC_URL=https://brb.happyhacks.io

# ---- Sign in with Happy Hacks ------------------------------------------------------------------------
# On the Happy Hacks server, from the happyhacks folder:
#   .venv/bin/python -m happyhacks.sso add doppleganger "BRB" https://brb.happyhacks.io/auth/happyhacks/callback
#   sudo supervisorctl restart happyhacks
# and paste the three lines it prints here:
HAPPYHACKS_URL=https://happyhacks.io
HAPPYHACKS_CLIENT_ID=
HAPPYHACKS_CLIENT_SECRET=

# 1 = people sign in with Happy Hacks before downloading; 0 (default) = anyone can download.
DOWNLOADS_REQUIRE_SIGNIN=0

# ---- /admin --------------------------------------------------------------------------------------------
# Emails or mobiles that are BRB admins (comma-separated); they become admins when they next sign in.
# Or: .venv/bin/python -m dopplesite.users admin you@example.com
ADMIN_CONTACTS=
# Backup way into /admin. The installer generates one and prints it once. Empty turns it off.
ADMIN_PASSWORD=

# ---- Licenses ------------------------------------------------------------------------------------------
# Free LOOP time per computer, in seconds, in total (3600 = 1 hour). Unlimited needs a license key.
FREE_SECONDS=3600

# Square: BRB Unlimited is a monthly subscription (same Square account settings as zipzip).
# Webhook: Square Developer Dashboard > Webhooks > Add subscription, URL https://brb.happyhacks.io/api/square/webhook,
# events subscription.created, subscription.updated, invoice.payment_made; paste its signature key below.
SQUARE_ENV=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_PRODUCTION_LOCATION_ID=
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://brb.happyhacks.io/api/square/webhook
# Price in cents ($5.00), and the early-bird price for people who subscribe while they still have free time ($2.50).
SUBSCRIPTION_PRICE_CENTS=500
EARLY_PRICE_CENTS=250

# ---- Releases ------------------------------------------------------------------------------------------
# The public GitHub repository BRB's releases are published to.
RELEASES_REPO=busybeavernc/brb-public
# Optional: a GitHub token (no scopes needed) if the site hits GitHub's API rate limit.
GITHUB_TOKEN=

# Where the small SQLite database lives (users, download counts). The installer sets this.
DATA_DIR=
